# Copy to android/keystore.properties (git-ignored) after running scripts/create-release-keystore.sh.
# storeFile is an absolute path, or relative to android/app/.
# Never commit the real file or the .jks. In CI, release.yml writes this file from repository secrets.
# To make a debug-signed (non-uploadable) release impossible, build with:
#   ./gradlew :app:bundleRelease -PhivaRequireReleaseKey=true
storeFile=/Users/you/.hiva-keystore/hiva-release.jks
storePassword=
keyAlias=hiva-upload
keyPassword=
